{
  "name": "biblioteca-digital-escolar",
  "version": "1.0.0",
  "description": "Biblioteca Digital Escolar: plataforma de lectura para escuela primaria (1.º a 7.º grado).",
  "main": "server/index.js",
  "private": true,
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "reset-db": "node --disable-warning=ExperimentalWarning server/reset.js",
    "build:html": "node tools/build-artifact.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
